{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gh0st",
  "version": "0.1.0",
  "identifier": "com.judgem.gh0st",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "gh0st Control", "width": 1060, "height": 780, "minWidth": 760, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"]
  }
}
