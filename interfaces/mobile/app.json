{
  "expo": {
    "name": "gh0st Mobile",
    "slug": "gh0st-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow gh0st to scan one-time pairing QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.cyberexperts.gh0st"
    },
    "android": {
      "package": "org.cyberexperts.gh0st",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {}
  }
}
